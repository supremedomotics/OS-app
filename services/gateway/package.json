    "@supreme/lan": "workspace:*",
    "@supreme/identity": "workspace:*",
    "@supreme/permissions": "workspace:*",
    "@supreme/home": "workspace:*",
    "@supreme/scenes": "workspace:*",
    "@supreme/notifications": "workspace:*",
    "@supreme/persistence": "workspace:*",
    "@supreme/messaging": "workspace:*",
    "@supreme/crypto": "workspace:*",
    "@supreme/hub-identity": "workspace:*",
    "@supreme/drivers": "workspace:*",
    "@supreme/commissioning": "workspace:*",
    "@supreme/licensing": "workspace:*",
    "@supreme/backup": "workspace:*",
    "@supreme/automations": "workspace:*",
    "@supreme/keypad-framework": "workspace:*",
    "@supreme/intent-engine": "workspace:*",
    "@supreme/analytics": "workspace:*",
    "@supreme/intelligence": "workspace:*",
    "@supreme/license-service": "workspace:*",
    "@supreme/audit": "workspace:*",
    "@supreme/ai": "workspace:*",
    "@supreme/security": "workspace:*",
    "@supreme/cameras": "workspace:*",
    "@supreme/homekit": "workspace:*",
    "@fastify/websocket": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
