{
  "name": "@supreme/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Supreme API Gateway / BFF — REST + WSS, the only client-facing surface.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@supreme/domain-model": "workspace:*",
    "@supreme/contracts": "workspace:*",
    "@supreme/integration-layer": "workspace:*",
    "@supreme/identity": "workspace:*",
    "@supreme/permissions": "workspace:*",
    "@supreme/home": "workspace:*",
    "@supreme/scenes": "workspace:*",
    "@supreme/notifications": "workspace:*",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.13"
  }
}
