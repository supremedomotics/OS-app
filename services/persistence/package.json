{
  "name": "@supreme/persistence",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres-backed repositories for the Supreme system of record (§5).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@supreme/domain-model": "workspace:*",
    "@supreme/identity": "workspace:*",
    "@supreme/home": "workspace:*",
    "@supreme/scenes": "workspace:*",
    "@supreme/permissions": "workspace:*",
    "@supreme/notifications": "workspace:*",
    "@supreme/drivers": "workspace:*",
    "@supreme/automations": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@supreme/integration-layer": "workspace:*",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
