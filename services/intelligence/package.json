{
  "name": "@supreme/intelligence",
  "version": "0.0.0",
  "private": true,
  "description": "Supreme Intelligence Engine — extensible, local-first intelligence modules (presence fusion, energy decisions, zones) as pure cores.",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
