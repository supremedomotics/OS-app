# Supreme Cloud (optional control plane). None of this is required for in-home use.

# Shared secret hubs present to the relay (tunnel registration + push forward). Must
# match each hub's SUPREME_RELAY_TOKEN / SUPREME_PUSH_RELAY_TOKEN.
SUPREME_RELAY_TOKEN=change-me-strong-relay-token

# Cloud Postgres password (fleet state). Use managed Postgres in production (see cloud-iac).
POSTGRES_PASSWORD=change-me-db-password

# Installer fleet API keys: "key1:orgA,key2:orgB".
SUPREME_FLEET_API_KEYS=

# Voice service (optional). HMAC secret for OAuth tokens + the OAuth clients Alexa/Google use to
# link. Clients: "clientId:secret:assistant:redirectUri" entries, comma-separated (alexa|google).
VOICE_SIGNING_SECRET=change-me-strong-voice-secret
VOICE_CLIENTS=

# Matter service (optional). Per-hub API keys "key1:home1,key2:home2" (issued at enrollment).
SUPREME_MATTER_API_KEYS=

SUPREME_LOG_LEVEL=info
