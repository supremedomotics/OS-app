# Supreme Cloud (optional control plane). None of this is required for in-home use.
#
# Canonical public hostnames (production domain: supremedomotics.in). Put a TLS-terminating
# reverse proxy in front and point each subdomain at the matching service:
#   app.supremedomotics.in       → homeowner web app (client surface; CORS origin)
#   id.supremedomotics.in        → Identity plane (AuthN issuer / token service)   :8093
#   broker.supremedomotics.in    → Tunnel Broker (hub-initiated mTLS + HTTP route) :8094/:8443
#   registry.supremedomotics.in  → Hub Registry (zero-touch enrollment)            :8092
#   cloud.supremedomotics.in     → relay / push / fleet                            :8090/:8091
#   voice.supremedomotics.in     → Voice OAuth IdP + Alexa/Google fulfillment      :8095
#   matter.supremedomotics.in    → Matter fabric/multi-admin metadata              :8096
# These are documented defaults — override per environment (dev/staging) as needed.

# Shared secret hubs present to the relay (tunnel registration + push forward). Must
# match each hub's SUPREME_RELAY_TOKEN / SUPREME_PUSH_RELAY_TOKEN.
SUPREME_RELAY_TOKEN=change-me-strong-relay-token

# Cloud Postgres password (fleet state). Use managed Postgres in production (see cloud-iac).
POSTGRES_PASSWORD=change-me-db-password

# Installer fleet API keys: "key1:orgA,key2:orgB".
SUPREME_FLEET_API_KEYS=

# Voice service (optional). HMAC secret for OAuth tokens + the OAuth clients Alexa/Google use to
# link. Clients: "clientId:secret:assistant:redirectUri" entries, comma-separated (alexa|google).
VOICE_SIGNING_SECRET=change-me-strong-voice-secret
VOICE_CLIENTS=
# Per-hub keys authenticating proactive state-report ingest (/v1/state): "key1:home1,key2:home2".
VOICE_HUB_KEYS=
# Real proactive-report dispatch (optional). Without these the service logs + drops reports.
#   Alexa: Login-with-Amazon client credentials for the skill.
VOICE_ALEXA_CLIENT_ID=
VOICE_ALEXA_CLIENT_SECRET=
#   Google: a HomeGraph service account (email + PEM private key).
VOICE_GOOGLE_SA_EMAIL=
VOICE_GOOGLE_SA_KEY=

# Matter service (optional). Per-hub API keys "key1:home1,key2:home2" (issued at enrollment).
SUPREME_MATTER_API_KEYS=

# Off-site backup vault (optional). Per-hub API keys "key1:home1,key2:home2" + retention per home.
SUPREME_BACKUPS_API_KEYS=
SUPREME_BACKUPS_RETENTION=30

SUPREME_LOG_LEVEL=info
