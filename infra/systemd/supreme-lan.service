# supreme-lan — SupremeOS LAN Transport Service (PRODUCTION deployment unit)
#
# § Production Architecture Direction. This is the shipping deployment: a native systemd service
# on the SupremeOS image, with direct access to the physical network interfaces. Docker is a
# development and CI environment only, and NOTHING in `@supreme/lan` branches on it — the same
# `dist/server/main.js` runs identically here and in a container. Switching between them is a
# deployment change (this file vs. a Compose override), never a protocol or transport change.
#
# Why this unit needs almost nothing special: because it runs in the host's own network namespace,
# broadcast reception, multicast reception, IGMP membership, mDNS, SSDP, KNX Routing/Discovery and
# Casambi UDP all work with no bridges, no NAT, no overlay files, and no per-protocol workarounds.
# The entire class of Docker networking problems documented in
# docs/architecture/Casambi-LAN-Receive-Path-Investigation.md simply does not exist here.
#
# Install: rendered by infra/native-linux (install.sh/update.sh/recover.sh) via
# render_template, substituting the ___PLACEHOLDER___ tokens below from lib/common.sh's
# path constants — never installed as a raw, unmodified copy (see § Bug fix below).
#   systemctl daemon-reload && systemctl enable --now supreme-lan
#
# § Bug fix (Phase 2 runtime investigation): this unit used to hardcode
# /opt/supreme/services/lan directly, which never existed under this deployment's actual
# staged-release layout (/opt/supreme/releases/<version>, symlinked from /opt/supreme/
# current) — every OTHER native-linux unit (supreme-gateway, supreme-commissioning) already
# runs from ___SUPREME_APP_DIR___/current/services/<name>. Real evidence:
# `status=200/CHDIR — No such file or directory`, because that directory was never staged
# anywhere. Fixed to use the same ___SUPREME_APP_DIR___/current/... convention as every
# sibling unit — there is now exactly one deployment path model, not two.

[Unit]
Description=SupremeOS LAN Transport Service (supreme-lan)
Documentation=file://___SUPREME_APP_DIR___/current/docs/architecture/Supreme-LAN-Transport-Architecture.md
# Ordering only — supreme-lan does not require NATS to be healthy to start; it reconnects.
# § Bug fix (Phase 3 repo-wide deployment audit): this referenced a unit named
# `nats-server.service`, which has never existed in this deployment — the real unit
# install.sh renders and enables is `supreme-nats.service` (see install.sh's
# configure_nats()). Referencing a nonexistent unit in `After=` is not an error systemd
# reports; it silently no-ops the ordering constraint instead, so this line has never
# actually done anything. Fixed to the real unit name.
After=network-online.target supreme-nats.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node ___SUPREME_APP_DIR___/current/services/lan/dist/server/main.js
WorkingDirectory=___SUPREME_APP_DIR___/current/services/lan
Restart=always
RestartSec=2

# The deployment identity this service reports in diagnostics. Read by `resolveDeployment()`;
# deliberately explicit rather than auto-detected — a process cannot reliably tell from inside its
# own network namespace whether it shares the host's, so guessing would produce confidently wrong
# diagnostics (see services/lan/src/server/deployment.ts).
Environment=SUPREME_LAN_DEPLOYMENT=native-linux
Environment=SUPREME_LAN_NATS_URL=nats://127.0.0.1:4222
Environment=NODE_ENV=production

# Hardening. Note what is deliberately NOT restricted: the network. This service's entire purpose
# is raw LAN socket access, so PrivateNetwork/NetworkNamespacePath must never be set here — that
# would recreate, on the production image, exactly the isolation that breaks broadcast/multicast
# in Docker bridge mode.
User=supreme
Group=supreme
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Binding a privileged port (<1024) is not required by any protocol currently carried (Casambi
# 10009, KNX 3671, mDNS 5353, SSDP 1900 are all unprivileged). If a future protocol needs one, add
# AmbientCapabilities=CAP_NET_BIND_SERVICE here rather than running the service as root.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# No capability is needed for UDP broadcast/multicast recv (IP_ADD_MEMBERSHIP is a plain
# socket option, not a privileged operation) — safe to drop every capability, matching every
# sibling unit (supreme-gateway/commissioning/nats.service).
CapabilityBoundingSet=
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
