# Copy to `.env` and fill in. The hub's sealed key store injects these in
# production; this file is for local hub bring-up only. NEVER commit a real .env.

# Backend selection: "ha" (real headless Home Assistant) or "mock" (no HA).
SUPREME_BACKEND=ha

# Long-lived Home Assistant access token, provisioned by the SIL and owned by it.
# Generated once during commissioning; HA's UI is never shown to operators.
SUPREME_HA_TOKEN=replace-with-long-lived-ha-token

# Supreme token-signing secret (>= 32 chars). Rotate via the sealed store.
SUPREME_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Postgres password for the Supreme system-of-record database.
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# Misc
SUPREME_TZ=UTC
SUPREME_LOG_LEVEL=info

# On-box AI assistant (Phase 3/4): set to 1 to compile the llama.cpp runtime into
# the ai image, and point at a GGUF model directory + file to enable the real LLM.
# Leave unset to use the built-in deterministic planner.
SUPREME_AI_WITH_LLM=0
SUPREME_AI_MODEL_DIR=./ai-models
SUPREME_AI_MODEL_PATH=

# Security hardening (production). NODE_ENV=production refuses to boot with the
# insecure dev token secret and requires an explicit CORS allow-list.
NODE_ENV=production
SUPREME_CORS_ORIGINS=https://app.supreme.example
SUPREME_RATE_MAX=1000
SUPREME_AUTH_RATE_MAX=20

# Cross-process scale (§5). Empty/unset → the gateway uses its in-process event bus
# and presence store (fine for a single gateway). Set these to fan device state +
# notifications across multiple gateway processes and share presence via Redis.
SUPREME_NATS_URL=nats://nats:4222
SUPREME_REDIS_URL=redis://redis:6379

# Sealed secrets (Docker/K8s convention): point *_FILE at a mounted secret file to
# avoid plaintext secrets in env. The *_FILE value wins over the plain var.
#   SUPREME_TOKEN_SECRET_FILE=/run/secrets/token_secret
#   SUPREME_HA_TOKEN_FILE=/run/secrets/ha_token
#   DATABASE_URL_FILE=/run/secrets/database_url

# Edge TLS (Caddy). For a real deployment set the hub's public domain + ACME email
# (auto-HTTPS). Default localhost uses Caddy's internal CA (self-signed) for dev.
SUPREME_DOMAIN=localhost
ACME_EMAIL=admin@supreme.local
