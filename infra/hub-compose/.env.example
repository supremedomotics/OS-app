# Copy to `.env` and fill in. The hub's sealed key store injects these in
# production; this file is for local hub bring-up only. NEVER commit a real .env.

# Backend selection: "ha" (real headless Home Assistant) or "mock" (no HA).
SUPREME_BACKEND=ha

# Home Assistant is provisioned AUTOMATICALLY on first boot — you do NOT set a token.
# The gateway creates HA's hidden internal account, mints a long-lived token, and stores
# it in the secrets volume. HA's UI is never shown to installers or homeowners.
# (Optional) set SUPREME_HA_TOKEN only to pin an existing token instead of provisioning.
# SUPREME_HA_TOKEN=
# The hidden internal HA account (never visible in any Supreme UI). Defaults shown.
# SUPREME_HA_ADMIN_USER=admin
# SUPREME_HA_ADMIN_PASSWORD=admin@supremeos
# Friendly system name seeded into HA + shown in the Supreme UI.
SUPREME_SYSTEM_NAME=Supreme Residence

# Room photos (§11): the hub picks a photo by room name, downloads it ONCE and serves it locally so
# every app shows the identical image offline. With no key it uses keyless Openverse (real
# Creative-Commons interior photos); set a free Unsplash Access Key (https://unsplash.com/developers)
# for higher-quality curated photos. The apps also fetch a photo client-side (Openverse) so real
# images appear even when the hub has no internet. Owners can upload their own photo per room too.
# SUPREME_UNSPLASH_KEY=

# First boot shows the Supreme Setup Wizard (create the administrator). Set 0 for a
# throwaway demo stack that auto-seeds a demo owner instead.
SUPREME_SETUP_WIZARD=1

# Developer Mode (DEBUG ONLY): also use docker-compose.dev-mode.yml to publish HA on 8123.
SUPREME_DEV_MODE=0

# Supreme token-signing secret (>= 32 chars). Rotate via the sealed store.
SUPREME_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Postgres password for the Supreme system-of-record database.
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# Misc
SUPREME_TZ=UTC
SUPREME_LOG_LEVEL=info

# On-box AI assistant (Phase 3/4): set to 1 to compile the llama.cpp runtime into
# the ai image, and point at a GGUF model directory + file to enable the real LLM.
# Leave unset to use the built-in deterministic planner.
SUPREME_AI_WITH_LLM=0
SUPREME_AI_MODEL_DIR=./ai-models
SUPREME_AI_MODEL_PATH=

# Security hardening (production). NODE_ENV=production refuses to boot with the
# insecure dev token secret and requires an explicit CORS allow-list.
NODE_ENV=production
SUPREME_CORS_ORIGINS=https://app.supremedomotics.in
SUPREME_RATE_MAX=1000
SUPREME_AUTH_RATE_MAX=20

# Cross-process scale (§5). Empty/unset → the gateway uses its in-process event bus
# and presence store (fine for a single gateway). Set these to fan device state +
# notifications across multiple gateway processes and share presence via Redis.
SUPREME_NATS_URL=nats://nats:4222
SUPREME_REDIS_URL=redis://redis:6379

# Distributed tracing (§6). Empty = off (no-op spans, no network). Point at an
# OTLP/HTTP collector's traces endpoint to export gateway request spans.
#   SUPREME_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
SUPREME_OTEL_ENDPOINT=

# Native protocol stacks (§3) the Supreme-native engine fronts. MQTT defaults to the
# hub's Mosquitto broker (real Zigbee2MQTT/Tasmota devices commission onto it). Modbus
# is per-site hardware: set the gateway/PLC host to enable the Modbus TCP driver.
SUPREME_MQTT_URL=mqtt://mqtt:1883
SUPREME_MODBUS_HOST=
SUPREME_MODBUS_PORT=502
# KNXnet/IP gateway (tunnelling) host — the backbone protocol for luxury EU installs.
SUPREME_KNX_HOST=
SUPREME_KNX_PORT=3671
# Matter local controller — opt-in (ships disabled per blueprint §9). Enabling it
# needs the on-box Matter controller subsystem; until then the driver stays idle.
SUPREME_MATTER_ENABLED=0
SUPREME_MATTER_STORAGE_PATH=/data/matter
# Native Zigbee coordinator (ConBee/Sonoff/CC26x2) serial port + herdsman adapter type.
# Talks ZCL directly — no MQTT broker / Zigbee2MQTT. Empty = driver not loaded.
SUPREME_ZIGBEE_PORT=
SUPREME_ZIGBEE_ADAPTER=zstack
# DALI (IEC 62386) USB interface serial port — addressable architectural lighting.
# Open standard. Empty = driver not loaded.
SUPREME_DALI_PORT=
# AVR IP control (Denon/Marantz published Telnet protocol). Receivers are added by IP
# address when a device is bound; set to 1 to load the driver.
SUPREME_AVR_ENABLED=0
# CoolMasterNet HVAC bridge host (CoolAutomation) for VRF/VRV control. Empty = off.
SUPREME_COOLMASTER_HOST=
# SIP door-station registrar/server (door release -> lock, ring -> sensor). Needs a
# SIP UA subsystem to be wired; empty = driver not loaded.
SUPREME_SIP_SERVER=

# Media + security drivers, added by IP/account at bind time. WiiM (LinkPlay HTTP) and
# Devialet (local IP-control) speak real local APIs. Sonos (UPnP/SOAP) needs a transport
# and Ajax (proprietary cloud) needs a partner API client provisioned.
SUPREME_WIIM_ENABLED=0
SUPREME_DEVIALET_ENABLED=0
SUPREME_SONOS_ENABLED=0
SUPREME_AJAX_ENABLED=0
# Shelly Gen2 (real local JSON-RPC + mDNS discovery). AirPlay (mDNS discovery is real;
# the audio-sender/streaming stack must be provisioned to actually play).
SUPREME_SHELLY_ENABLED=0
SUPREME_AIRPLAY_ENABLED=0
# Apple TV: mDNS discovery (_mediaremotetv._tcp) is real; full media control + rich
# now-playing (foreground app + content) run through the bundled pyatv bridge, which
# holds the per-device pairing credentials. Enable the driver, then pair once (see
# services/appletv-py/README.md). The bridge URL defaults to the compose service.
SUPREME_APPLETV_ENABLED=0
SUPREME_APPLETV_URL=http://appletv:9300
# Public hub URL used to build client-reachable cover-art URLs (defaults to https://<domain>).
# SUPREME_PUBLIC_BASE_URL=https://home.example
# Lutron LIP integration over Telnet — covers WIRED RadioRA 2 / HomeWorks QS and the
# WIRELESS Caséta Smart Bridge Pro through the same bridge. Set the bridge host to enable.
SUPREME_LUTRON_HOST=
SUPREME_LUTRON_USERNAME=lutron
SUPREME_LUTRON_PASSWORD=integration
# Tuya (proprietary): real path needs a device client + per-device local keys (tuyapi) or
# the Tuya Cloud SDK provisioned; capability↔DPS mapping is ready.
SUPREME_TUYA_ENABLED=0
# Casambi (Bluetooth-mesh luminaires) via Casambi Cloud (REST + WebSocket). Needs a
# WebSocket-enabled API key from Casambi + network admin credentials. The driver auto-maps
# Casambi groups to Supreme rooms and derives capabilities per fixture. Prefer the *_FILE
# convention (sealed secrets) for the key and password so they never live in plaintext env.
SUPREME_CASAMBI_API_KEY=
SUPREME_CASAMBI_EMAIL=
SUPREME_CASAMBI_PASSWORD=
# Optional: pin a single network id for a faster session handshake.
SUPREME_CASAMBI_NETWORK_ID=

# Camera streaming (RTSP -> HLS/WebRTC via the bundled go2rtc "streamer"). Clients
# reach playable streams at /stream behind the edge proxy; the gateway registers
# camera RTSP sources via go2rtc's admin API. Empty STREAM_BASE_URL = hand back the
# raw rtsp:// source (native players only).
SUPREME_STREAM_BASE_URL=https://localhost/stream
SUPREME_STREAM_ENGINE=go2rtc
SUPREME_STREAM_API_URL=http://streamer:1984

# Push notifications (§13) — OPTIONAL. Notifications always deliver over WSS; push
# additionally reaches backgrounded devices via the optional cloud relay (which holds
# the FCM/APNs/WebPush credentials so the hub never needs them). Empty = push off.
#   SUPREME_PUSH_RELAY_URL=https://cloud.supremedomotics.in/v1/push
#   SUPREME_PUSH_RELAY_TOKEN_FILE=/run/secrets/push_relay_token
SUPREME_PUSH_RELAY_URL=
SUPREME_PUSH_RELAY_TOKEN=

# Proactive voice reporting (§9, ADR 0010) — OPTIONAL. When set, the hub publishes local device
# state changes (debounced) to the cloud Voice service so Alexa/Google stay in sync. The hub key
# maps to this home on the Voice service (its VOICE_HUB_KEYS). Empty = off.
#   SUPREME_VOICE_CLOUD_URL=https://voice.supremedomotics.in
#   VOICE_HUB_KEY_FILE=/run/secrets/voice_hub_key
SUPREME_VOICE_CLOUD_URL=
VOICE_HUB_KEY=

# Remote access (§8) — OPTIONAL. The hub dials this relay OUTBOUND (no inbound ports);
# off-LAN clients reach the hub through the tunnel. Same relay as push; token must match
# the cloud's SUPREME_RELAY_TOKEN. Empty = LAN-only.
SUPREME_RELAY_URL=
SUPREME_RELAY_TOKEN=

# OTA updates (§14) — OPTIONAL. The hub checks this SIGNED release manifest and logs
# when a newer version is available (it does not self-apply). The public key verifies
# the manifest's Ed25519 signature so a compromised channel can't push a bad release.
SUPREME_OTA_URL=
SUPREME_OTA_PUBLIC_KEY=

# Sealed secrets (Docker/K8s convention): point *_FILE at a mounted secret file to
# avoid plaintext secrets in env. The *_FILE value wins over the plain var.
#   SUPREME_TOKEN_SECRET_FILE=/run/secrets/token_secret
#   SUPREME_HA_TOKEN_FILE=/run/secrets/ha_token
#   DATABASE_URL_FILE=/run/secrets/database_url

# Edge TLS (Caddy). For a real deployment set the hub's public domain + ACME email
# (auto-HTTPS). Default localhost uses Caddy's internal CA (self-signed) for dev.
SUPREME_DOMAIN=localhost
ACME_EMAIL=admin@supreme.local
