{
  "name": "@supreme/hub-pki",
  "version": "0.0.0",
  "private": true,
  "description": "X.509 Hub CA + device certificates for mutual-TLS hub↔broker auth (ADR 0008/0009).",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "main": "./dist/index.js",
