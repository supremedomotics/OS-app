  },
  "dependencies": {
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
