# Dependencies
node_modules/
.pnpm-store/

# Local agent-tooling runtime state (daemon pid/logs/metrics — machine-specific, not source)
.claude-flow/
.claude/.proven-config-version
.claude/memory.json
.claude/proven-config.json

# Playwright MCP debug/scratch output (page snapshots, screenshots from ad-hoc QA runs — not
# project source, regenerated per session)
.claude/playwright-output/

# Home Assistant container runtime state (bind-mounted, regenerated on each run — not source)
infra/hub-compose/homeassistant/.ha_run.lock
infra/hub-compose/homeassistant/.HA_VERSION
infra/hub-compose/homeassistant/home-assistant.log*
infra/hub-compose/homeassistant/home-assistant_v2.db
infra/hub-compose/homeassistant/blueprints/

# Build output
dist/
build/
*.tsbuildinfo
.turbo/

# Python
__pycache__/
*.py[cod]
.venv/
.uv/
*.egg-info/

# Flutter / Dart
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
**/ios/Pods/
**/build/

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.log

# Local data volumes
infra/hub-compose/.data/

# Dart/Flutter library lockfiles (libraries should not pin; apps keep theirs)
packages/aureon-flutter/pubspec.lock
packages/supreme-sdk-dart/pubspec.lock

# Environment-specific proxy CA certs (populated by enable-native-tools.sh)
infra/hub-compose/ca-certs/*.crt

# On-box AI model weights (provisioned to the appliance, never committed)
services/ai-py/models/

# On-box AI model mount (compose); weights provisioned at runtime
infra/hub-compose/ai-models/
